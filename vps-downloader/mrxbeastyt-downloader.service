[Unit]
Description=MRXBEASTYT VPS Downloader Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/vps-downloader
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5000

[Install]
WantedBy=multi-user.target
